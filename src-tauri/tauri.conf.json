{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyFlow",
  "version": "0.1.0",
  "identifier": "com.myflow.dev",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "pill",
        "url": "pill.html",
        "title": "MyFlow",
        "width": 400,
        "height": 66,
        "x": null,
        "y": null,
        "center": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "MyFlow Settings",
        "width": 600,
        "height": 840,
        "resizable": true,
        "visible": false
      },
      {
        "label": "notes",
        "url": "notes.html",
        "title": "MyFlow Notes",
        "width": 400,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "MyFlow",
    "shortDescription": "Hold CapsLock to dictate, release to paste.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
